{
	"name": "williamstownsc",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": "24.12.0"
	},
	"scripts": {
		"dev": "next dev --port 3003",
		"build": "pnpm run type:gen && next build",
		"build:sanity": "sanity build",
		"deploy:sanity": "sanity deploy",
		"start": "next start",
		"lint": "eslint",
		"lint-staged": "lint-staged",
		"format": "prettier . --write .",
		"format:check": "prettier . --check",
		"prepare": "husky",
		"type:gen": "sanity schema extract --path src/sanity && sanity typegen generate",
		"type:check": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@aws-sdk/client-ses": "3.1121.0",
		"@date-fns/tz": "1.5.0",
		"@dejanvasic85/matchday-sdk": "2.3.0",
		"@fontsource/exo": "5.3.0",
		"@fontsource/outfit": "5.3.0",
		"@next/third-parties": "16.3.4",
		"@portabletext/toolkit": "6.0.0",
		"@portabletext/types": "4.0.2",
		"@sanity/client": "7.26.2",
		"@sanity/icons": "5.2.1",
		"@sanity/image-url": "2.1.1",
		"@sanity/ui": "4.0.7",
		"@sanity/vision": "6.11.0",
		"@sentry/nextjs": "10.72.0",
		"@tanstack/react-query": "5.102.8",
		"clsx": "2.1.1",
		"daisyui": "5.7.22",
		"date-fns": "4.4.0",
		"lucide-react": "1.35.0",
		"next": "16.3.4",
		"next-sanity": "13.3.3",
		"pino": "10.3.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.86.0",
		"sanity": "6.11.0",
		"styled-components": "6.5.3",
		"zod": "4.5.1"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "4.3.3",
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"commander": "15.0.0",
		"dotenv": "17.4.2",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.4",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"pino-pretty": "13.1.3",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,md}": [
			"prettier . --write",
			"eslint ."
		]
	},
	"browserslist": "> 1%"
}
